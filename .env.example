# SpendIQ Frontend Environment Configuration
# Optional: Set custom API URL if FastAPI backend is hosted on a separate host/port.
# If omitted or empty, Vite proxies '/api' calls to http://127.0.0.1:8000.
VITE_API_URL=

# Google OAuth 2.0 / OpenID Connect Client ID (Optional)
# If left empty, SpendIQ automatically queries backend /api/auth/google/config
VITE_GOOGLE_CLIENT_ID=
